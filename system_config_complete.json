  "diagnostic_protocols": {
    "OBD2": {
      "description_ar": "بروتوكول التشخيص القياسي للسيارات",
      "description_en": "Standard automotive diagnostic protocol",
      "connector_type": "16-pin DLC",
      "voltage": "12V",
      "supported_services": [
        "Service 01 - Current Data",
        "Service 02 - Freeze Frame Data",
        "Service 03 - Stored DTCs",
        "Service 04 - Clear DTCs",
        "Service 05 - O2 Sensor Tests",
        "Service 06 - On-Board Tests",
        "Service 07 - Pending DTCs",
        "Service 08 - Control Operation",
        "Service 09 - Vehicle Information"
      ]
    },
    "UDS": {
      "description_ar": "خدمات التشخيص الموحدة",
      "description_en": "Unified Diagnostic Services",
      "iso_standard": "ISO 14229",
      "transport_protocols": [
        "ISO-TP",
        "DoIP"
      ],
      "services": [
        "0x10 - Diagnostic Session Control",
        "0x11 - ECU Reset",
        "0x14 - Clear DTC",
        "0x18 - Read DTC Information",
        "0x19 - Read DTC Information",
        "0x22 - Read Data By Identifier",
        "0x23 - Read Memory By Address",
        "0x27 - Security Access",
        "0x2E - Write Data By Identifier",
        "0x31 - Routine Control",
        "0x34 - Request Download",
        "0x35 - Request Upload",
        "0x36 - Transfer Data",
        "0x37 - Request Transfer Exit"
      ]
    },
    "KWP2000": {
      "description_ar": "بروتوكول الكلمات المفتاحية 2000",
