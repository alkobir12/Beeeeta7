  "troubleshooting": {
    "common_issues": {
      "permission_denied": {
        "problem_ar": "خطأ في الصلاحيات",
        "problem_en": "Permission denied error",
        "solutions": [
          "chmod +x universal_automotive_diagnostic_complete_system.py",
          "sudo python3 universal_automotive_diagnostic_complete_system.py",
          "Run as Administrator (Windows)"
        ]
      },
      "module_not_found": {
        "problem_ar": "مكتبة غير موجودة",
        "problem_en": "Module not found",
        "solutions": [
          "pip install -r requirements.txt",
          "python -m pip install --upgrade pip",
          "Check Python version compatibility"
        ]
      },
      "port_already_used": {
        "problem_ar": "المنفذ مُستخدم مسبقاً",
        "problem_en": "Port already in use",
        "solutions": [
          "Change port in config: --port 5001",
          "Kill existing process: lsof -ti:5000 | xargs kill",
          "Use different port number"
        ]
      },
      "obd_connection_failed": {
        "problem_ar": "فشل الاتصال بـ OBD",
        "problem_en": "OBD connection failed",
        "solutions": [
          "Check ELM327 device connection",
          "Verify COM port settings",
          "Test with different baud rate",
          "Check vehicle ignition ON"
        ]
      }
    }
  },
