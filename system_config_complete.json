  "docker_installation": {
    "dockerfile_content": [
      "FROM python:3.9-slim",
      "WORKDIR /app",
      "COPY requirements.txt .",
      "RUN pip install -r requirements.txt",
      "COPY . .",
      "EXPOSE 5000",
      "CMD [\"python\", \"universal_automotive_diagnostic_complete_system.py\", \"--web\"]"
    ],
    "docker_compose": {
      "version": "3.8",
      "services": {
        "automotive-system": {
          "build": ".",
          "ports": [
            "5000:5000"
          ],
          "volumes": [
            "./data:/app/data"
          ],
          "environment": {
            "FLASK_ENV": "production",
            "API_KEY": "AIzaSyDqTL_NAa3gC_ER54ZHcyuIE6cPUD108gM"
          }
        }
      }
    },
    "commands": [
      "docker build -t automotive-system .",
      "docker run -p 5000:5000 automotive-system",
      "docker-compose up -d"
    ]
  },
